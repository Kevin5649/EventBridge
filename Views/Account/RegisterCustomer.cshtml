@model EventBridge.ViewModels.RegisterCustomerViewModel

@{
    ViewData["Title"] = "Register as Customer";
    Layout = "_LandingLayout";
}

<div class="register-page">

    <div class="register-container">

        <!-- LEFT SIDE -->
        <div class="register-info">

            <div class="register-info-content">

                <div class="register-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <h1>Bring Your Event<br />to Life.</h1>

                <p>
                    Find the right event planner, share your requirements,
                    compare quotations and make your event memorable.
                </p>

                <div class="register-info-image">
                    <img src="~/images/event-hero.jpg"
                         alt="Event celebration">
                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="register-form-section">

            <div class="register-card">

                <div class="register-heading">

                    <h1>Create Your Account</h1>

                    <p>
                        Join EventBridge as a customer
                    </p>

                </div>


                <form asp-action="RegisterCustomer"
                      asp-controller="Account"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- FULL NAME -->
                    <div class="register-field">

                        <label asp-for="FullName">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               aria-required="true"
                               placeholder="John Doe" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->
                    <div class="register-field">

                        <label asp-for="Email">
                            Email address
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PHONE -->
                    <div class="register-field">
                        <label asp-for="Phone">
                            Phone
                        </label>

                        <div class="phone-input-group">
                            <div class="country-selector" id="customerCountrySelector">

                                <button type="button"
                                        class="country-selector-button"
                                        id="customerCountryButton">

                                    <span class="selected-country-flag">🇮🇳</span>
                                    <span class="selected-country-code">+91</span>
                                    <i class="fa-solid fa-chevron-down"></i>

                                </button>

                                <div class="country-dropdown">

                                    <div class="country-search">
                                        <i class="fa-solid fa-magnifying-glass"></i>

                                        <input type="text"
                                               id="customerCountrySearch"
                                               placeholder="Search country or code"
                                               autocomplete="off" />
                                    </div>

                                    <div class="country-list"
                                         id="customerCountryList">
                                    </div>

                                </div>

                                <input asp-for="CountryCode"
                                       type="hidden"
                                       id="CustomerCountryCode" />

                            </div>

                            <input asp-for="Phone"
                                   class="form-control phone-number-input"
                                   id="Phone"
                                   inputmode="numeric"
                                   autocomplete="tel-national"
                                   maxlength="10"
                                   aria-required="true"
                                   placeholder="9876543210" />

                        </div>

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>
                    </div>


                    <!-- PASSWORD -->
                    <div class="register-field">

                        <label asp-for="Password">
                            Password
                        </label>

                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Create a password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->
                    <div class="register-field">

                        <label asp-for="ConfirmPassword">
                            Confirm Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Confirm your password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ADDRESS -->
                    <div class="register-field">

                        <label asp-for="Address">
                            Address
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control register-textarea"
                                  aria-required="true"
                                  placeholder="Your Address"></textarea>

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- REGISTER -->
                    <button id="registerSubmit"
                            type="submit"
                            class="btn register-submit-btn w-100">

                        Create Account

                    </button>


                    <div class="register-login">

                        <p>
                            Already have an account?
                        </p>

                        <a asp-action="Login">
                            Log in here
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}