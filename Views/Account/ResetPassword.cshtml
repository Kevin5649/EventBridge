@model EventBridge.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_LandingLayout";
}

<div class="reset-password-page">

    <div class="reset-password-card">

        <div class="reset-password-icon">
            <i class="fa-solid fa-lock"></i>
        </div>

        <div class="reset-password-heading">

            <h1>Reset Your Password</h1>

            <p>
                Create a new password for your EventBridge account.
            </p>

        </div>


        <form asp-action="ResetPassword"
              asp-controller="Account"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- EMAIL -->
            <div class="reset-field">

                <label asp-for="Email">
                    Email address
                </label>

                <input asp-for="Email"
                       class="form-control"
                       readonly
                       aria-required="true" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- PASSWORD -->
            <div class="reset-field">

                <label asp-for="Password">
                    New Password
                </label>

                <input asp-for="Password"
                       class="form-control"
                       type="password"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Enter your new password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>


            <!-- CONFIRM PASSWORD -->
            <div class="reset-field">

                <label asp-for="ConfirmPassword">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control"
                       type="password"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Confirm your new password" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- HIDDEN RESET CODE -->
            <input asp-for="Code"
                   type="hidden" />


            <!-- RESET BUTTON -->
            <button type="submit"
                    class="btn reset-submit-btn w-100">

                Reset Password

            </button>


            <div class="reset-back">

                <a asp-action="Login">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Back to Login
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}