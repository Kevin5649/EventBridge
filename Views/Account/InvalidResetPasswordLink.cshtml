@{
    ViewData["Title"] = "Invalid Reset Link";
    Layout = "_LandingLayout";
}

<div class="forgot-password-page">

    <div class="forgot-password-card">

        <div class="forgot-password-icon">
            <i class="fa-solid fa-link-slash"></i>
        </div>

        <div class="forgot-password-heading">

            <h1>Reset Link Invalid or Expired</h1>

            <p>
                This password reset link is no longer valid.
                Please request a new password reset link.
            </p>

        </div>

        <a asp-action="ForgotPassword"
           class="btn forgot-submit-btn w-100">

            Request New Reset Link

        </a>

        <div class="forgot-back">

            <a asp-action="Login">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Back to Login
            </a>

        </div>

    </div>

</div>