@{
    ViewData["Title"] = "Email Already Verified";
    Layout = "_LandingLayout";
}

<div class="forgot-password-page">

    <div class="forgot-password-card">

        <div class="forgot-password-icon">
            <i class="fa-solid fa-circle-check"></i>
        </div>

        <div class="forgot-password-heading">

            <h1>Email Already Verified</h1>

            <p>
                Your EventBridge email address has already been verified.
                You can continue to login to your account.
            </p>

        </div>

        <a asp-action="Login"
           class="btn forgot-submit-btn w-100">

            Continue to Login

        </a>

        

    </div>

</div>