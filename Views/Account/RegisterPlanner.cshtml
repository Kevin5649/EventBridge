@model EventBridge.ViewModels.RegisterPlannerViewModel

@{
    ViewData["Title"] = "Register as Event Planner";
    Layout = "_LandingLayout";
}

<div class="register-page">

    <div class="register-container">

        <!-- LEFT SIDE -->
        <div class="register-info">

            <div class="register-info-content">

                <div class="register-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <h1>Grow Your<br />Event Business.</h1>

                <p>
                    Join EventBridge, connect with customers and
                    showcase your event planning services.
                </p>

                <div class="register-info-image">
                    <img src="~/images/event-hero.jpg"
                         alt="Event celebration">
                </div>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="register-form-section">

            <div class="register-card">

                <div class="register-heading">

                    <h1>Become an Event Planner</h1>

                    <p>
                        Create your EventBridge planner account
                    </p>

                </div>


                <form asp-action="RegisterPlanner"
                      asp-controller="Account"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- FULL NAME -->
                    <div class="register-field">

                        <label asp-for="FullName">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               aria-required="true"
                               placeholder="John Doe" />

                        <span asp-validation-for="FullName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->
                    <div class="register-field">

                        <label asp-for="Email">
                            Email address
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PHONE -->
                    <div class="register-field">
                        <label asp-for="Phone">Phone</label>

                        <div class="phone-input-group">
                            <div class="country-selector" id="plannerCountrySelector">

                                <button type="button"
                                        class="country-selector-button"
                                        id="plannerCountryButton">

                                    <span class="selected-country-flag">🇮🇳</span>
                                    <span class="selected-country-code">+91</span>
                                    <i class="fa-solid fa-chevron-down"></i>

                                </button>

                                <div class="country-dropdown">

                                    <div class="country-search">
                                        <i class="fa-solid fa-magnifying-glass"></i>

                                        <input type="text"
                                               id="plannerCountrySearch"
                                               placeholder="Search country or code"
                                               autocomplete="off" />
                                    </div>

                                    <div class="country-list"
                                         id="plannerCountryList">
                                    </div>

                                </div>

                                <input asp-for="CountryCode"
                                       type="hidden"
                                       id="PlannerCountryCode" />

                            </div>

                            <input asp-for="Phone"
                                   class="form-control phone-number-input"
                                   id="Phone"
                                   inputmode="numeric"
                                   autocomplete="tel-national"
                                   maxlength="10"
                                   aria-required="true"
                                   placeholder="9876543210" />

                        </div>

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>
                    </div>


                    <!-- COMPANY -->
                    <div class="register-field">

                        <label asp-for="CompanyName">
                            Company Name
                        </label>

                        <input asp-for="CompanyName"
                               class="form-control"
                               aria-required="true"
                               placeholder="Your company name" />

                        <span asp-validation-for="CompanyName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EXPERIENCE -->
                    <div class="register-field">

                        <label asp-for="Experience">
                            Experience (Years)
                        </label>

                        <input asp-for="Experience"
                               class="form-control"
                               aria-required="true"
                               placeholder="5"
                               type="number"
                               min="0"
                               max="50" />

                        <span asp-validation-for="Experience"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EVENT TYPES -->
                    <div class="register-field">

                        <label>
                            Event Types You Provide
                        </label>

                        <p class="register-category-help">
                            Select the types of events you specialize in.
                        </p>

                        <div class="register-category-grid">

                            @foreach (var category in Model.Categories)
                            {
                                <label class="register-category-option">

                                    <input type="checkbox"
                                           name="SelectedCategoryIds"
                                           value="@category.Value"
                                    @(category.Selected ? "checked" : "") />

                                    <span>
                                        @category.Text
                                    </span>

                                </label>
                            }

                        </div>

                        <span asp-validation-for="SelectedCategoryIds"
                              class="text-danger"
                              id="categoryValidation">
                        </span>

                    </div>


                    <!-- PASSWORD -->
                    <div class="register-field">

                        <label asp-for="Password">
                            Password
                        </label>

                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Create a password" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->
                    <div class="register-field">

                        <label asp-for="ConfirmPassword">
                            Confirm Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               type="password"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Confirm your password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DESCRIPTION -->
                    <div class="register-field">

                        <label asp-for="Description">
                            Company Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control register-textarea"
                                  aria-required="true"
                                  placeholder="Tell customers about your event planning services"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- REGISTER -->
                    <button id="registerSubmit"
                            type="submit"
                            class="btn register-submit-btn w-100">

                        Create Planner Account

                    </button>


                    <div class="register-login">

                        <p>
                            Already have an account?
                        </p>

                        <a asp-action="Login">
                            Log in here
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            $("form").on("submit", function (e) {

                var checkedCategories =
                    $('input[name="SelectedCategoryIds"]:checked').length;

                if (checkedCategories === 0) {

                    $("#categoryValidation")
                        .text("Please select at least one event type.");

                    e.preventDefault();

                } else {

                    $("#categoryValidation").text("");

                }

            });


            $('input[name="SelectedCategoryIds"]').on("change", function () {

                if ($('input[name="SelectedCategoryIds"]:checked').length > 0) {

                    $("#categoryValidation").text("");

                }

            });

        });
    </script>
}