@model IEnumerable<EventBridge.Models.Customer>

@{
    ViewData["Title"] = "Customer Report";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-primary">Customer Report</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to Reports</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4 bg-light rounded-4">
            <form asp-action="Customers" method="get" class="row g-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control border-start-0 ps-0" placeholder="Search by name or email..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="sortOrder" class="form-select">
                        <option value="">Sort By: Name (A-Z)</option>
                        <option value="name_desc" selected="@(ViewBag.NameSortParm == "name_desc")">Sort By: Name (Z-A)</option>
                        <option value="Date" selected="@(ViewBag.DateSortParm == "Date")">Sort By: Oldest First</option>
                        <option value="date_desc" selected="@(ViewBag.DateSortParm == "date_desc")">Sort By: Newest First</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary shadow-sm me-2">Apply Filters</button>
                    <a asp-action="Customers" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted">
                        <tr>
                            <th class="ps-4">Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Registration Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.User?.ProfilePicturePath))
                                        {
                                            <img src="@item.User.ProfilePicturePath" class="rounded-circle me-3 border" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center me-3 border" style="width: 40px; height: 40px;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        }
                                        @item.User?.FullName
                                    </div>
                                </td>
                                <td>@item.User?.Email</td>
                                <td>@item.User?.PhoneNumber</td>
                                <td>@item.Address</td>
                                <td>
                                    @if (item.User != null && item.User.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">@item.User?.CreatedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">No customers found matching the criteria.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-0 p-3 text-muted small text-end">
            Total Records: @Model.Count()
        </div>
    </div>
</div>
