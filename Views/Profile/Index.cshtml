@model EventBridge.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page">
    
        <div class="mb-4">
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="profile-back-btn">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Dashboard
            </a>
        </div>
    
    <div class="row">

        <!-- PROFILE SUMMARY -->
        <div class="col-md-4 mb-4">

            <div class="card shadow-sm border-0 rounded-3">

                <div class="card-body text-center">

                    @if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
                    {
                        <img src="@Model.ProfilePicturePath"
                             alt="Profile Picture"
                             class="rounded-circle img-thumbnail mb-3"
                             style="width:150px;height:150px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="profile-placeholder rounded-circle img-thumbnail mb-3">
                            <i class="fa-regular fa-user"></i>
                        </div>
                    }

                    <h4 class="mb-1">
                        @Model.FullName
                    </h4>

                    <p class="text-muted mb-2">
                        @Model.Role
                    </p>

                    <a asp-action="ChangePassword"
                       class="btn btn-outline-secondary btn-sm mt-2">

                        <i class="fa-solid fa-lock me-1"></i>
                        Change Password

                    </a>

                </div>

            </div>

        </div>


        <!-- EDIT PROFILE -->
        <div class="col-md-8">

            <div class="card shadow-sm border-0 rounded-3">

                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">

                    <h5 class="mb-0 text-primary fw-bold">
                        Edit Profile
                    </h5>

                </div>


                <div class="card-body p-4">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">

                            <i class="fa-solid fa-circle-check me-2"></i>

                            @TempData["SuccessMessage"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>

                        </div>
                    }


                    <form asp-action="Edit"
                          enctype="multipart/form-data"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- NAME + PHONE -->
                        <div class="row">

                            <div class="col-md-6 mb-3 form-floating">

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Full Name" />

                                <label asp-for="FullName"
                                       class="ms-2">
                                </label>

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3 form-floating">

                                <input asp-for="Phone"
                                       class="form-control"
                                       placeholder="Phone" />

                                <label asp-for="Phone"
                                       class="ms-2">
                                </label>

                                <span asp-validation-for="Phone"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- EMAIL -->
                        <div class="mb-3 form-floating">

                            <input asp-for="Email"
                                   class="form-control"
                                   disabled
                                   placeholder="Email" />

                            <label asp-for="Email">
                            </label>

                            <small class="text-muted">
                                Email cannot be changed.
                            </small>

                        </div>


                        <!-- PROFILE PICTURE -->
                        <div class="mb-3">

                            <label asp-for="ProfilePicture"
                                   class="form-label">

                                Update Profile Picture

                            </label>

                            <input asp-for="ProfilePicture"
                                   class="form-control"
                                   type="file"
                                   accept=".jpg,.jpeg,.png" />

                        </div>


                        <!-- CUSTOMER -->
                        @if (Model.Role == "Customer")
                        {
                            <div class="mb-3 form-floating">

                                <textarea asp-for="Address"
                                          class="form-control"
                                          style="height:100px"
                                          placeholder="Address">
                                    </textarea>

                                <label asp-for="Address">
                                </label>

                                <span asp-validation-for="Address"
                                      class="text-danger">
                                </span>

                            </div>
                        }


                        <!-- EVENT PLANNER -->
                        @if (Model.Role == "EventPlanner")
                        {
                            <div class="row">

                                <div class="col-md-8 mb-3 form-floating">

                                    <input asp-for="CompanyName"
                                           class="form-control"
                                           placeholder="Company Name" />

                                    <label asp-for="CompanyName"
                                           class="ms-2">
                                    </label>

                                    <span asp-validation-for="CompanyName"
                                          class="text-danger">
                                    </span>

                                </div>


                                <div class="col-md-4 mb-3 form-floating">

                                    <input asp-for="Experience"
                                           class="form-control"
                                           type="number"
                                           placeholder="Experience" />

                                    <label asp-for="Experience"
                                           class="ms-2">
                                    </label>

                                    <span asp-validation-for="Experience"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <div class="mb-4 form-floating">

                                <textarea asp-for="Description"
                                          class="form-control"
                                          style="height:100px"
                                          placeholder="Description">
                                    </textarea>

                                <label asp-for="Description">
                                </label>

                                <span asp-validation-for="Description"
                                      class="text-danger">
                                </span>

                            </div>
                        }


                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="fa-solid fa-check me-1"></i>

                            Save Changes

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/profile.css"
          asp-append-version="true" />

}


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}