@model EventBridge.Models.Quotation

@{
    ViewData["Title"] = "Quotation Details";
    bool isCustomer = User.IsInRole("Customer");
}

<link rel="stylesheet" href="~/css/planner-sidebar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/planner-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/customer-sidebar.css" asp-append-versin="true"/>

<div class="planner-dashboard">

    <!-- SIDEBAR -->
    <partial name="_UserSidebar" />

    <!-- MAIN CONTENT -->
    <main class="planner-dashboard-content">

        <!-- HEADER -->
        <div class="admin-dashboard-header">

            <div>
                <span class="text-muted small text-uppercase fw-bold">
                    <i class="fa-solid fa-file-invoice me-2"></i>
                    Quotation
                </span>

                <h2 class="fw-bold mt-1">
                    Quotation #@Model.Id
                </h2>

                <p class="text-muted mb-0">
                    Review the quotation and event requirements.
                </p>
            </div>

            <a asp-controller="Enquiry"
               asp-action="Details"
               asp-route-id="@Model.EnquiryId"
               class="btn btn-outline-secondary rounded-pill px-4">

                <i class="fa-solid fa-arrow-left me-2"></i>
                Back to Enquiry

            </a>

        </div>


        <!-- SUCCESS MESSAGE -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }


        <!-- ERROR MESSAGE -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }


        <!-- QUOTATION SUMMARY -->
        <div class="admin-table-card mb-4">

            <div class="admin-table-header">

                <div>
                    <span class="text-muted small text-uppercase fw-bold">
                        QUOTATION
                    </span>

                    <h3 class="mt-1">
                        @Model.Enquiry?.EventPlanner?.CompanyName
                    </h3>

                    <p>
                        Quotation submitted for your event enquiry.
                    </p>
                </div>

                <div class="text-end">

                    <span class="text-muted small">
                        Total Amount
                    </span>

                    <h2 class="fw-bold text-success mb-0">
                        ₹@Model.Amount.ToString("N2")
                    </h2>

                </div>

            </div>


            <div class="p-4">

                <!-- QUOTATION DETAILS -->
                <div class="mb-4">

                    <h5 class="fw-bold mb-3">
                        <i class="fa-solid fa-file-lines me-2"></i>
                        Quotation Details
                    </h5>

                    <div class="p-4 bg-light rounded-3">

                        <p class="mb-0"
                           style="white-space: pre-wrap;">
                            @Model.Description
                        </p>

                    </div>

                </div>


                <!-- QUOTATION INFORMATION -->
                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="p-3 bg-light rounded-3">

                            <small class="text-muted d-block">
                                Status
                            </small>

                            @if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark mt-1">
                                    <i class="fa-regular fa-clock me-1"></i>
                                    Pending
                                </span>
                            }
                            else if (Model.Status == "Accepted")
                            {
                                <span class="badge bg-success mt-1">
                                    <i class="fa-solid fa-circle-check me-1"></i>
                                    Accepted
                                </span>
                            }
                            else if (Model.Status == "Rejected")
                            {
                                <span class="badge bg-danger mt-1">
                                    <i class="fa-solid fa-circle-xmark me-1"></i>
                                    Rejected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary mt-1">
                                    @Model.Status
                                </span>
                            }

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="p-3 bg-light rounded-3">

                            <small class="text-muted d-block">
                                Created On
                            </small>

                            <strong>
                                @Model.CreatedAt.ToString("MMM dd, yyyy")
                            </strong>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="p-3 bg-light rounded-3">

                            <small class="text-muted d-block">
                                Valid Till
                            </small>

                            <strong>
                                @Model.ValidTill.ToString("MMM dd, yyyy")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- EVENT REQUIREMENTS -->
        <div class="admin-table-card mb-4">

            <div class="admin-table-header">

                <div>
                    <span class="text-muted small text-uppercase fw-bold">
                        EVENT REQUIREMENTS
                    </span>

                    <h3 class="mt-1">
                        Customer's Requirements
                    </h3>

                    <p>
                        Details submitted by the customer in the enquiry.
                    </p>
                </div>

            </div>


            <div class="p-4">

                <div class="row g-4">

                    <!-- EVENT TYPE -->
                    <div class="col-md-4">

                        <div class="p-3 border rounded-3 h-100">

                            <small class="text-muted d-block mb-1">
                                <i class="fa-solid fa-layer-group me-1"></i>
                                Event Type
                            </small>

                            <strong>
                                @Model.Enquiry?.Category?.Name
                            </strong>

                        </div>

                    </div>


                    <!-- EVENT DATE -->
                    <div class="col-md-4">

                        <div class="p-3 border rounded-3 h-100">

                            <small class="text-muted d-block mb-1">
                                <i class="fa-regular fa-calendar me-1"></i>
                                Event Date
                            </small>

                            <strong>
                                @Model.Enquiry?.EventDate.ToString("MMMM dd, yyyy")
                            </strong>

                        </div>

                    </div>


                    <!-- GUEST COUNT -->
                    <div class="col-md-4">

                        <div class="p-3 border rounded-3 h-100">

                            <small class="text-muted d-block mb-1">
                                <i class="fa-solid fa-users me-1"></i>
                                Guest Count
                            </small>

                            <strong>
                                @Model.Enquiry?.GuestCount guests
                            </strong>

                        </div>

                    </div>


                    <!-- BUDGET -->
                    <div class="col-md-4">

                        <div class="p-3 border rounded-3 h-100">

                            <small class="text-muted d-block mb-1">
                                <i class="fa-solid fa-wallet me-1"></i>
                                Customer Budget
                            </small>

                            <strong>
                                ₹@Model.Enquiry?.Budget.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <!-- SENT ON -->
                    <div class="col-md-4">

                        <div class="p-3 border rounded-3 h-100">

                            <small class="text-muted d-block mb-1">
                                <i class="fa-regular fa-clock me-1"></i>
                                Enquiry Sent
                            </small>

                            <strong>
                                @Model.Enquiry?.CreatedAt.ToString("MMM dd, yyyy")
                            </strong>

                        </div>

                    </div>


                    <!-- ENQUIRY STATUS -->
                    <div class="col-md-4">

                        <div class="p-3 border rounded-3 h-100">

                            <small class="text-muted d-block mb-1">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                Enquiry Status
                            </small>

                            <strong>
                                @Model.Enquiry?.Status
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- CUSTOMER MESSAGE -->
                <div class="mt-4">

                    <small class="text-muted d-block mb-2 fw-bold">
                        <i class="fa-regular fa-message me-1"></i>
                        Customer Requirements / Message
                    </small>

                    <div class="p-4 bg-light rounded-3">

                        <p class="mb-0"
                           style="white-space: pre-wrap;">
                            @Model.Enquiry?.Message
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- CUSTOMER / PLANNER INFORMATION -->
        <div class="admin-table-card mb-4">

            <div class="admin-table-header">

                <div>

                    <span class="text-muted small text-uppercase fw-bold">
                        CONTACT
                    </span>

                    <h3 class="mt-1">
                        @(isCustomer ? "Planner Information" : "Customer Information")
                    </h3>

                </div>

            </div>


            <div class="p-4">

                @if (isCustomer)
                {
                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Planner / Company
                            </small>

                            <strong>
                                @Model.Enquiry?.EventPlanner?.CompanyName
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Email
                            </small>

                            <a href="mailto:@Model.Enquiry?.EventPlanner?.User?.Email">
                                @Model.Enquiry?.EventPlanner?.User?.Email
                            </a>

                        </div>

                    </div>
                }
                else
                {
                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Customer Name
                            </small>

                            <strong>
                                @Model.Enquiry?.Customer?.User?.FullName
                            </strong>

                        </div>

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Email
                            </small>

                            <a href="mailto:@Model.Enquiry?.Customer?.User?.Email">
                                @Model.Enquiry?.Customer?.User?.Email
                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- CUSTOMER ACTIONS -->
        @if (isCustomer && Model.Status == "Pending")
        {
            <div class="d-flex justify-content-end gap-3 mb-5">

                <form asp-action="Reject"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to reject this quotation?');">

                    <button type="submit"
                            class="btn btn-outline-danger btn-lg rounded-pill px-4">

                        <i class="fa-solid fa-xmark me-2"></i>
                        Reject Quote

                    </button>

                </form>


                <form asp-action="Accept"
                      asp-route-id="@Model.Id"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to accept this quotation and proceed to booking?');">

                    <button type="submit"
                            class="btn btn-success btn-lg rounded-pill px-5">

                        <i class="fa-solid fa-check me-2"></i>
                        Accept & Book

                    </button>

                </form>

            </div>
        }

    </main>

</div>